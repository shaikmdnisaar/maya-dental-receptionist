# Database (SQLite for dev — no server needed. Use PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Auth
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Demo mode (works without external credentials)
DEMO_MODE=true

# Voice provider: mock | twilio | retell | vapi
VOICE_PROVIDER=mock
VOICE_API_KEY=
VOICE_WEBHOOK_SECRET=

# Calendar provider: mock | google
CALENDAR_PROVIDER=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Messaging provider: mock | twilio
MESSAGING_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# App
NEXT_PUBLIC_APP_NAME="Dental Voice Agent"
NEXT_PUBLIC_DEMO_MODE=true